#!/bin/sh

NUM="${2:-5}"
# SINK_NAME="Family"
# SINK_NAME="GA104"
[[ "$(pulsemixer --list-sinks | grep Headphones | wc -l)" == "1" ]] && SINK_NAME="Headphones"
[[ "$(pulsemixer --list-sinks | grep GA104 | wc -l)" == "1" ]] && SINK_NAME="GA104"
# Uncomment the following line to use Pulseaudio.
PULSE=true
SINK=$(pulsemixer --list-sinks | grep $SINK_NAME | awk '{print $3}' | sed s/,//g)
SINK=$(pulsemixer --list-sinks | grep $SINK_NAME | awk '{print $3}' | sed s/,//g)

if [ "$PULSE" ]; then
	toggle() { pulsemixer --id $SINK --toggle-mute ;}
	mute() { pulsemixer --id $SINK --mute ;}
	up() { pulsemixer --id $SINK --change-volume +"$NUM" ;}
	down() { pulsemixer --id $SINK --change-volume -"$NUM" ;}
	control() { pulsemixer --id $SINK ;}
else
	toggle() { amixer sset Master toggle ;}
	mute() { amixer sset Master mute ;}
	up() { amixer sset Master "$NUM"%+ ;}
	down() { amixer sset Master "$NUM"%- ;}
	control() { alsamixer ;}
fi

case "$1" in
	toggle) toggle ;;
	mute) mute ;;
	up) up ;;
	down) down ;;
	control) control ;;
esac

CURRENT_VOL=$(pulsemixer --get-volume --id $SINK | awk '{ print $2 }')%
notify-send "Volume: $CURRENT_VOL"
