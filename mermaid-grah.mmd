graph TD
    %% Networking
    subgraph Networking
        VPN[VPN]
        DNS[DNS]
        Firewall[Firewall]
        LB[Load Balancer]
    end

    %% Servers
    subgraph Servers
        WebServer[Web Server]
        DB[Database Server]
        Storage[Cloud Storage]
        MQ[Message Queue]
    end

    %% Security
    subgraph Security
        IDS[Intrusion Detection System]
        IPS[Intrusion Prevention System]
    end

    %% Applications
    subgraph Applications
        CI[CI/CD Pipelines]
        AppServer[Application Server]
        Monitoring[Monitoring Tools]
    end

    %% Scalability
    subgraph Scalability
        AutoScaling[Auto-Scaling]
        HA[High Availability]
    end

    %% User Interaction
    User[User]
    Form[Infrastructure Form]

    %% Connections
    %% Web Server Dependencies
    WebServer -->|Requires| Firewall:::common
    WebServer -->|Optional| LB:::common
    WebServer -->|Optional| AutoScaling:::common

    %% Message Queue Dependencies
    MQ -->|Requires| DB:::mq_color
    MQ -->|Depends On| Storage:::mq_color
    MQ -->|Relies On| Monitoring:::mq_color

    %% Overlapping Dependencies
    DB -->|Relies On| Storage:::common

    %% Other Dependencies
    LB -->|Depends On| Firewall:::common
    Firewall -->|Configures| VPN:::common
    AutoScaling -->|Relies On| Storage:::common
    AppServer -->|Depends On| DB:::common
    CI -->|Monitored By| Monitoring:::common
    Monitoring -->|Secures| IDS:::common
    IDS -->|Works With| IPS:::common
    AutoScaling -->|Supports| HA:::common
    DNS -->|Supports| WebServer:::common

    %% User Interaction
    User -->|Fills| Form:::user_color
    Form -->|Enable Web Server| WebServer:::common
    Form -->|Enable Message Queue| MQ:::mq_color

    %% Information theory inference
    classDef common fill:#ADD8E6,stroke:#000,stroke-width:2px;
    classDef mq_color fill:#FFD700,stroke:#000,stroke-width:2px;
    classDef user_color fill:#90EE90,stroke:#000,stroke-width:2px;
