+def set_csrf_cookie_on_response(
+    request: Request, response: Response, session_timeout_hours: int | None
+) -> None:
+    """Set the readable double-submit CSRF cookie on an existing response.
+
+    `CSRFMiddleware` rejects every PUT/POST/PATCH/DELETE that has a `cb_session` cookie but no
+    matching `cb_csrf` cookie and `X-CSRF-Token` header. Password login sets both cookies
+    (`auth_response_with_cookie`); the OAuth/OIDC redirects set only the session cookie, so a
+    user who signed in through an identity provider could read but never write (HTTP 403,
+    "CSRF token missing").
+    """
+    response.set_cookie(
+        key=CSRF_COOKIE_NAME,
+        value=secrets.token_hex(32),
+        max_age=(session_timeout_hours or 24) * 3600,
+        httponly=False,  # must be readable by JS for the double-submit pattern
+        secure=_is_secure_request(request),
+        samesite="strict",
+        path="/",
+    )
+
