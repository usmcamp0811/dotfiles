grammar(v: &mut Vec<String>, t: &mut String);

pub Select: () = {
    SELECT <c:Columns> FROM <tbl:TableName> SEMICOLON => {}
};

Columns: () = {
    <l:LITERAL> => v.push(l),
    Columns "," <l:LITERAL> => v.push(l),
};

TableName: () = {
    <l:LITERAL> => *t = l,
};

SELECT: String = <s:r"select\s+"> => s.to_string();
FROM: String = <s:r"\s+from\s+"> => s.to_string();
LITERAL: String = <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string();
SEMICOLON: String = <s:r";"> => s.to_string();
