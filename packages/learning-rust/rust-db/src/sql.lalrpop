grammar;

use std::collections::HashMap;
use crate::parser::Statement;
use crate::table::DataType;

pub Statement: Statement = {
    SelectStmt
  , InsertStmt
  , CreateStmt
  , DeleteStmt
  , UpdateStmt
};

Value: DataType = {
  <s:STRING_LITERAL> => DataType::String(s),
  <n:INT_LITERAL> => DataType::Integer32(n),
  <f:FLOAT_LITERAL> => DataType::Float32(f),
};

SelectStmt: Statement = {
  SELECT <cols:Columns> FROM <tbl:TableName> WHERE <col:LITERAL> "=" <val:Value> SEMICOLON =>
    Statement::Select {
      columns: cols,
      table: tbl,
      where_clause: Some((col, val)),
    },

  SELECT <cols:Columns> FROM <tbl:TableName> SEMICOLON =>
    Statement::Select {
      columns: cols,
      table: tbl,
      where_clause: None,
    }
};

CreateStmt: Statement = {
  CREATE TABLE <tbl:TableName> LPAREN <fields:Schema> RPAREN SEMICOLON =>
    Statement::Create {
      table: tbl,
      schema: fields,
    }
};

InsertStmt: Statement = {
  INSERT INTO <tbl:TableName> LPAREN <cols:Columns> RPAREN VALUES LPAREN <vals:Values> RPAREN SEMICOLON =>
    Statement::Insert {
      table: tbl,
      columns: cols,
      values: vals,
    }
};

DeleteStmt: Statement = {
  DELETE FROM <tbl:TableName> WHERE <col:LITERAL> "=" <val:Value> SEMICOLON =>
    Statement::Delete {
      table: tbl,
      where_column: col,
      where_value: val,
    }
};

UpdateStmt: Statement = {
  UPDATE <tbl:TableName> SET <set_col:LITERAL> "=" <set_val:Value> WHERE <where_col:LITERAL> "=" <where_val:Value> SEMICOLON =>
    Statement::Update {
      table: tbl,
      set_column: set_col,
      set_value: set_val,
      where_column: where_col,
      where_value: where_val,
    }
};

Columns: Vec<String> = {
  <c:LITERAL> => vec![c],
  <mut v: Columns> "," <c:LITERAL> => { v.push(c); v }
};

Schema: HashMap<String, DataType> = {
  <f:Field> => {
    let mut map = HashMap::new();
    map.insert(f.0, f.1);
    map
  },
  <mut map: Schema> "," <f:Field> => {
    map.insert(f.0, f.1);
    map
  }
};

Field: (String, DataType) = {
  <name:LITERAL> <dtype:Type> => (name, dtype),
};

Values: Vec<DataType> = {
  <v:Value> => vec![v],
  <mut acc: Values> "," <v:Value> => {
    acc.push(v);
    acc
  }
};

Type: DataType = {
    "int" => DataType::Integer32(0),
    "float" => DataType::Float32(0.0),
    "string" => DataType::String(String::new()),
};

TableName: String = <s:LITERAL> => s;

CREATE: String = "create" => "create".to_string();
TABLE: String = "table" => "table".to_string();
SELECT: String = "select" => "select".to_string();
FROM: String = "from" => "from".to_string();
WHERE: String = "where" => "where".to_string();
DELETE: String = "delete" => "delete".to_string();
UPDATE: String = "update" => "update".to_string();
SET: String = "set" => "set".to_string();
INSERT: String = "insert" => "insert".to_string();
INTO: String = "into" => "into".to_string();
VALUES: String = "values" => "values".to_string();
LITERAL: String = <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string();
SEMICOLON: String = <s:r";"> => s.to_string();
LPAREN: String = <s:r"\("> => s.to_string();
RPAREN: String = <s:r"\)"> => s.to_string();
STRING_LITERAL: String = <s:r#""[^"]*""#> => s[1..s.len()-1].to_string();
INT_LITERAL: i32 = <s:r"[0-9]+"> => s.parse().unwrap();
FLOAT_LITERAL: f32 = <s:r"[0-9]+\.[0-9]+"> => s.parse().unwrap();
