use std::collections::HashMap;
grammar(cs: &mut Vec<String>, tn: &mut String, schema: &mut HashMap<String, crate::table::DataType>, vs: &mut Vec<crate::table::DataType>);

pub Statement: () = {
  SelectStmt,
  CreateStmt,
  InsertStmt,
};

SelectStmt: () = {
  SELECT <cols:Columns> FROM <tbl:TableName> SEMICOLON => {
    cs.extend(cols);
    *tn = tbl;
  }
};

CreateStmt: () = {
  CREATE TABLE <tbl:TableName> LPAREN <fields:Schema> RPAREN SEMICOLON => {
    *tn = tbl;
    schema.extend(fields);
  }
};

Columns: Vec<String> = {
  <c:LITERAL> => vec![c],
  <mut v: Columns> "," <c:LITERAL> => {
    v.push(c);
    v
  }
};

Schema: HashMap<String, crate::table::DataType> = {
  <f:Field> => {
    let mut map = HashMap::new();
    map.insert(f.0, f.1);
    map
  },
  <mut map: Schema> "," <f:Field> => {
    map.insert(f.0, f.1);
    map
  }
};

Field: (String, crate::table::DataType) = {
  <name:LITERAL> <dtype:Type> => (name, dtype),
};

Type: crate::table::DataType = {
  "STRING" => crate::table::DataType::String(String::new()),
  "INT" => crate::table::DataType::Integer32(0),
  "FLOAT" => crate::table::DataType::Float32(0.0)
}

TableName: String = <s:LITERAL> => s;


CREATE: String = "create" => "create".to_string();
TABLE: String = "table" => "table".to_string();
SELECT: String = "select" => "select".to_string();
FROM: String = "from" => "from".to_string();
LITERAL: String = <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string();
SEMICOLON: String = <s:r";"> => s.to_string();
LPAREN: String = <s:r"\("> => s.to_string();
RPAREN: String = <s:r"\)"> => s.to_string();


InsertStmt: () = {
  INSERT INTO <tbl:TableName> LPAREN <cols:Columns> RPAREN VALUES LPAREN <vals:Values> RPAREN SEMICOLON => {
    cs.extend(cols);
    *tn = tbl;
    vs.extend(vals);
  }
};

Values: Vec<crate::table::DataType> = {
  <v:Value> => vec![v],
  <mut acc: Values> "," <v:Value> => {
    acc.push(v);
    acc
  }
};

Value: crate::table::DataType = {
  <s:STRING_LITERAL> => crate::table::DataType::String(s),
  <n:INT_LITERAL> => crate::table::DataType::Integer32(n),
  <f:FLOAT_LITERAL> => crate::table::DataType::Float32(f),
};

STRING_LITERAL: String = <s:r#""[^"]*""#> => s[1..s.len()-1].to_string();
INT_LITERAL: i32 = <s:r"[0-9]+"> => s.parse().unwrap();
FLOAT_LITERAL: f32 = <s:r"[0-9]+\.[0-9]+"> => s.parse().unwrap();
VALUES: String = "values" => "values".to_string();
INSERT: String = "insert" => "insert".to_string();
INTO: String = "into" => "into".to_string();
