        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P428ABEA7BD9582B5"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    b.name AS budget_name,\n    COALESCE(SUM(t.amount), 0) AS amount_spent,\n    COALESCE(bl.amount, 0) AS budgeted_amount\nFROM\n    budgets b\n    LEFT JOIN budget_limits bl ON b.id = bl.budget_id\n    LEFT JOIN budget_transaction_journal btj ON b.id = btj.budget_id\n    LEFT JOIN transaction_journals tj ON btj.transaction_journal_id = tj.id\n    LEFT JOIN transactions t ON t.transaction_journal_id = tj.id\n        AND t.amount > 0\n        AND tj.date >= bl.start_date -- Filter transactions to be within the budget's start date\n        AND (bl.end_date IS NULL OR tj.date <= bl.end_date) -- Handle open-ended budgets\nWHERE\n    b.active = TRUE -- Only include active budgets\n    AND b.name IN ('Shopping', 'Travel', 'Food') -- Filter by specific budget names\n    AND bl.start_date >= date_trunc('month', CURRENT_DATE) -- Budget limit starts in the current month\n    AND (bl.end_date IS NULL OR bl.end_date < date_trunc('month', CURRENT_DATE) + INTERVAL '1 month') -- Budget limit ends within the current month\nGROUP BY\n    b.name,\n    bl.amount\nORDER BY\n    b.name;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
