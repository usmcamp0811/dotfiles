          "rawQuery": true,
          "rawSql": "SELECT\n    COALESCE(SUM(t.amount), 0) AS \"IN+OUT\"\nFROM\n    transactions t\nLEFT JOIN transaction_journals tj ON t.transaction_journal_id = tj.id\nLEFT JOIN accounts a ON t.account_id = a.id\nLEFT JOIN account_types at ON a.account_type_id = at.id\nWHERE\n    at.type = 'Asset account' -- Only include transactions related to 'Asset account'\n    AND tj.date >= date_trunc('month', CURRENT_DATE) -- Filter transactions to be within the current month\n    AND tj.date < date_trunc('month', CURRENT_DATE) + INTERVAL '1 month'\n    AND tj.deleted_at IS NULL\n",
