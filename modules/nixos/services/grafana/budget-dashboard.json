          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    c.name AS category_name,\n    COALESCE(SUM(t.amount), 0) AS amount_spent\nFROM\n    categories c\n    LEFT JOIN category_transaction_journal ctj ON c.id = ctj.category_id\n    LEFT JOIN transaction_journals tj ON ctj.transaction_journal_id = tj.id\n    LEFT JOIN transactions t ON t.transaction_journal_id = tj.id\n        AND t.amount > 0\n        AND tj.date >= date_trunc('month', CURRENT_DATE) -- Filter transactions to be within the current month\n        AND tj.date < date_trunc('month', CURRENT_DATE) + INTERVAL '1 month'\nWHERE\n    c.name IN ('Groceries', 'Eating Out') -- Filter for specific categories\nGROUP BY\n    c.name\nHAVING\n    SUM(t.amount) > 0 -- Exclude categories with a 0 balance\nORDER BY\n    c.name;\n",
