          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    tj.description AS description,\n    t.amount AS amount,\n    tj.date AS date,\n    c.name AS category\nFROM\n    transactions t\nLEFT JOIN transaction_journals tj ON t.transaction_journal_id = tj.id\nLEFT JOIN accounts a ON t.account_id = a.id\nLEFT JOIN account_types at ON a.account_type_id = at.id\nLEFT JOIN category_transaction_journal ctj ON tj.id = ctj.transaction_journal_id\nLEFT JOIN categories c ON ctj.category_id = c.id\nWHERE\n    at.type = 'Asset account' -- Only include transactions from 'Asset accounts'\nORDER BY\n    tj.date DESC\nLIMIT 20;\n",
