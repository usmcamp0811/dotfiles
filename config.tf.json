{
  "data": {
    "aws_iam_policy_document": {
      "assume_role": {
        "statement": {
          "actions": [
            "sts:AssumeRole"
          ],
          "effect": "Allow",
          "principals": {
            "identifiers": [
              "lambda.amazonaws.com"
            ],
            "type": "Service"
          }
        }
      },
      "step_function_execution": {
        "statement": [
          {
            "actions": [
              "lambda:InvokeFunction"
            ],
            "effect": "Allow",
            "resources": [
              {
                "depends_on": [
                  "resource.null_resource.pdf_ocr",
                  "resource.aws_iam_role.iam_for_lambda"
                ],
                "environment": {
                  "variables": {
                    "INPUT_BUCKET": "initech-tps-reports-bucket",
                    "OUTPUT_BUCKET": "initech-output-bucket"
                  }
                },
                "function_name": "pdf_ocr",
                "image_uri": "${aws_ecr_repository.campground_ecr.repository_url}:weather-example-latest",
                "memory_size": 512,
                "package_type": "Image",
                "role": "${aws_iam_role.iam_for_lambda.arn}",
                "timeout": 120
              },
              "arn"
            ]
          }
        ]
      }
    },
    "http": {
      "public_ip": {
        "url": "http://checkip.amazonaws.com/"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "us-east-1"
    }
  },
  "resource": {
    "aws_ecr_lifecycle_policy": {
      "campground_ecr": {
        "depends_on": [
          "resource.aws_ecr_repository.campground_ecr"
        ],
        "policy": "{\"rules\":[{\"action\":{\"type\":\"expire\"},\"description\":\"Keep only 10 images\",\"rulePriority\":1,\"selection\":{\"countNumber\":10,\"countType\":\"imageCountMoreThan\",\"tagPrefixList\":[\"prod\"],\"tagStatus\":\"tagged\"}}]}",
        "repository": "campground_ecr"
      },
      "my-main-ecr": {
        "depends_on": [
          "resource.aws_ecr_repository.my-main-ecr"
        ],
        "policy": "{\"rules\":[{\"action\":{\"type\":\"expire\"},\"description\":\"Keep only 10 images\",\"rulePriority\":1,\"selection\":{\"countNumber\":10,\"countType\":\"imageCountMoreThan\",\"tagPrefixList\":[\"prod\"],\"tagStatus\":\"tagged\"}}]}",
        "repository": "my-main-ecr"
      }
    },
    "aws_ecr_repository": {
      "campground_ecr": {
        "force_delete": true,
        "image_scanning_configuration": {
          "scan_on_push": true
        },
        "image_tag_mutability": "MUTABLE",
        "name": "campground_ecr"
      },
      "my-main-ecr": {
        "force_delete": true,
        "image_scanning_configuration": {
          "scan_on_push": true
        },
        "image_tag_mutability": "MUTABLE",
        "name": "my-main-ecr"
      }
    },
    "aws_iam_role": {
      "iam_for_lambda": {
        "assume_role_policy": "${data.aws_iam_policy_document.assume_role.json}",
        "name": "iam_for_lambda"
      },
      "iam_for_step_function": {
        "assume_role_policy": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Principal\": {\n        \"Service\": \"states.amazonaws.com\"\n      },\n      \"Action\": \"sts:AssumeRole\"\n    }\n  ]\n}\n",
        "name": "iam_for_step_function"
      }
    },
    "aws_iam_role_policy": {
      "step_function_execution_policy": {
        "name": "step_function_execution_policy",
        "policy": "${data.aws_iam_policy_document.step_function_execution.json}",
        "role": "${aws_iam_role.iam_for_step_function.id}"
      }
    },
    "aws_lambda_function": {
      "pdf_ocr": {
        "depends_on": [
          "resource.null_resource.pdf_ocr",
          "resource.aws_iam_role.iam_for_lambda"
        ],
        "environment": {
          "variables": {
            "INPUT_BUCKET": "initech-tps-reports-bucket",
            "OUTPUT_BUCKET": "initech-output-bucket"
          }
        },
        "function_name": "pdf_ocr",
        "image_uri": "${aws_ecr_repository.campground_ecr.repository_url}:weather-example-latest",
        "memory_size": 512,
        "package_type": "Image",
        "role": "${aws_iam_role.iam_for_lambda.arn}",
        "timeout": 120
      }
    },
    "aws_s3_bucket": {
      "campground-input-bucket": {
        "bucket": "campground-input-bucket",
        "force_destroy": false,
        "tags": {
          "createdBy": "Terranix",
          "environment": "dev",
          "project": "Campground-DefaultAWS"
        }
      }
    },
    "aws_s3_bucket_policy": {
      "campground-input-bucket_policy": {
        "bucket": "campground-input-bucket",
        "depends_on": [
          "aws_s3_bucket.campground-input-bucket"
        ],
        "policy": "{\"Statement\":[{\"Action\":\"s3:GetObject\",\"Condition\":{\"IpAddress\":{\"aws:SourceIp\":[]}},\"Effect\":\"Allow\",\"Principal\":\"*\",\"Resource\":\"arn:aws:s3:::campground-input-bucket/*\"}],\"Version\":\"2012-10-17\"}"
      }
    },
    "aws_step_function": {
      "pdf_ocr_workflow": {
        "definition": "{\n  \"Comment\": \"A simple Step Function for PDF OCR\",\n  \"StartAt\": \"OCRProcessing\",\n  \"States\": {\n    \"OCRProcessing\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"${aws_lambda_function.pdf_ocr.arn}\",\n      \"End\": true\n    }\n  }\n}\n",
        "depends_on": [
          "aws_lambda_function.pdf_ocr",
          "aws_iam_role.iam_for_step_function"
        ],
        "name": "pdf_ocr_workflow",
        "role_arn": "${aws_iam_role.iam_for_step_function.arn}"
      }
    },
    "null_resource": {
      "pdf_ocr": {
        "depends_on": [
          "aws_ecr_repository.campground_ecr"
        ],
        "provisioner": {
          "local-exec": {
            "command": "/nix/store/54bjr8wlfsdsnswbnjxyf5dd0095ak52-build-push/bin/build-push ${aws_ecr_repository.campground_ecr.repository_url}"
          }
        },
        "triggers": {
          "always_run": true,
          "package_hash": "b607890e9d3d5b3818413e64666b601f49ea0cb64bac0136ca683c444105fd71",
          "registry_url": "${aws_ecr_repository.campground_ecr.repository_url}"
        }
      }
    }
  },
  "terraform": {
    "backend": {
      "s3": {
        "bucket": "campground-state-bucket",
        "key": "state/terraform.tfstate",
        "region": "us-east-1"
      }
    }
  }
}
